{
  "rewrites": [
    {
      "source": "/api/beacon-fallback/eth/v1/beacon/headers/head",
      "destination": "https://pulsechain-beacon-api.publicnode.com/eth/v1/beacon/headers/head"
    },
    {
      "source": "/api/beacon-fallback/eth/v2/beacon/blocks/:slot(\\d+)",
      "destination": "https://pulsechain-beacon-api.publicnode.com/eth/v2/beacon/blocks/:slot"
    },
    {
      "source": "/api/beacon/eth/v1/beacon/headers/head",
      "destination": "https://rpc-pulsechain.g4mm4.io/beacon-api/eth/v1/beacon/headers/head"
    },
    {
      "source": "/api/beacon/eth/v2/beacon/blocks/:slot(\\d+)",
      "destination": "https://rpc-pulsechain.g4mm4.io/beacon-api/eth/v2/beacon/blocks/:slot"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://vitals.vercel-insights.com https://va.vercel-scripts.com; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests;"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
